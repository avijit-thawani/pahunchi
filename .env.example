# OpenRouter (LLM, speech-to-text, text-to-speech). Falls back to the shared ../.env.
OPENROUTER_API_KEY=

# Stop paid lab calls once the ledger total would exceed this (USD)
PHONEY_BUDGET_USD=8

# Supabase: deployed call logs (Storage bucket phoney-logs). Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project for accounts + trusted contacts (public values, bundled into the browser).
# Set them in Netlify's env vars too. Schema: supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Call logging: unset = Supabase if configured, else logs/calls/ (dev server forces local)
# PHONEY_LOG=local|off

# Deployed site only (Netlify env vars): shared password + cookie signing secret
PHONEY_PASSWORD=
PHONEY_COOKIE_SECRET=
